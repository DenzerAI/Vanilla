# Standard: nur explizit freigegebene Code- und Builddateien versionieren.
*
!/.gitignore
!/package.json
!/package-lock.json
!/configure-agent-uptime.sh
!/backend/
!/backend/*.mjs
!/frontend/
!/frontend/*.js
!/frontend/*.css
!/frontend/index.html
!/scripts/
!/scripts/*.py
!/scripts/*.mjs
!/test/
!/test/*.mjs
!/jobs/
!/jobs/briefings/
!/jobs/briefings/*.py
!/wrapper/
!/wrapper/.gitignore
!/wrapper/*.mjs
!/wrapper/package.json
!/wrapper/package-lock.json
!/wrapper/test/
!/wrapper/test/*.mjs
!/wrapper/ui/
!/wrapper/ui/*.mjs
!/wrapper/ui/*.jsx
!/wrapper/ui/*.css
!/wrapper/ui/index.html

# Verbindliche Ausschluesse, auch innerhalb freigegebener Verzeichnisse.
.env
.env.*
*.db
*.sqlite*
secrets/
credentials*
data/
work/
logs/
*.log
__pycache__/
node_modules/
.venv/
.git/
.DS_Store
workspaces/
brain/
soul/
research_tmp/
assets/
dist/
protocol/
backup*/

# CI-Quelle, Dokumentation und lizenzierte lokale Schriftdateien.
!/wrapper/DESIGN.md
!/wrapper/ui/assets/
!/wrapper/ui/assets/fonts/
!/wrapper/ui/assets/fonts/*.woff2
!/wrapper/ui/assets/fonts/*-LICENSE.txt
!/wrapper/ui/assets/fonts/sources.json

# Security audit: private baseline, findings and runtime permission inventory stay local.
/.security-audit/
!/.env.example
!/SECURITY.md
# Defense in depth for explicitly admitted source trees.
*.pem
*.key
*.p12
*.pfx
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.session
*.bak
uploads/
attachments/
transcripts/
cache/

# Shipped skill illustrations and their license are required by the build.
!/wrapper/ui/assets/skills/
!/wrapper/ui/assets/skills/*.png
!/wrapper/ui/assets/skills/LICENSE
!/wrapper/ui/assets/skills/sources.json
!/wrapper/ui/assets/gmail.svg
!/wrapper/ui/assets/outlook.svg
!/wrapper/ui/assets/whatsapp.svg
!/wrapper/ui/assets/higgsfield.png
!/wrapper/ui/assets/elevenlabs.svg
!/wrapper/ui/assets/n8n.svg
!/wrapper/ui/assets/calendar.svg
!/wrapper/ui/assets/sources.json

# Gemeinsame fachliche Basis und ihre Betriebsdokumentation.
!/firmenbasis/
!/firmenbasis/AGENTS.md
!/firmenbasis/FIRMA.md
!/firmenbasis/*/
!/firmenbasis/*/SKILL.md
!/README.md
!/wrapper/README.md
!/AGENTS.md

# Sprachfunktionen und verbindliche Aufbauverträge werden mit ausgeliefert.
!/wrapper/AGENTS.md
!/wrapper/DICTATION.md
!/wrapper/VOICE.md
!/wrapper/surfaces/
!/wrapper/surfaces/*.md
!/wrapper/scripts/
!/wrapper/scripts/setup-dictation.mjs
!/wrapper/scripts/setup-speech.mjs
!/wrapper/scripts/dictation.py
!/wrapper/scripts/speech.py
!/wrapper/ui/dictation-worklet.js
!/wrapper/ui/assets/groq.svg
!/wrapper/ui/assets/voice-brands-sources.json

# Gemeinsamer technischer Vertrag.
!/system/
!/system/*.md
!/system/*.mjs
!/wrapper/WORKERS.md

# Original monochrome agent avatars.
!/wrapper/ui/assets/avatars/
!/wrapper/ui/assets/avatars/*.svg

# Marken der neuen Verbindungsanbieter.
!/wrapper/ui/assets/telegram.svg
!/wrapper/ui/assets/discord.svg
!/wrapper/ui/assets/openai.svg
!/wrapper/CHANNELS.md

# Python core, Vite/TypeScript/Tailwind sources and portable installation files.
!/pyproject.toml
!/requirements.lock
!/requirements-embeddings.lock
!/core/
!/core/*.py
!/core/tests/
!/core/tests/*.py
!/core/tests/*.cjs
!/wrapper/*.ts
!/wrapper/tsconfig.json
!/wrapper/ui/*.ts
!/wrapper/ui/*.tsx
!/wrapper/public/
!/wrapper/public/*.js
!/wrapper/public/*.css
!/wrapper/public/*.svg
!/wrapper/public/*.webmanifest
!/wrapper/ui/assets/a2a.svg
!/wrapper/ui/assets/crm/
!/wrapper/ui/assets/crm/*.png
!/wrapper/ui/assets/crm/*.svg
!/wrapper/ui/assets/crm/*.json
!/docs/
!/docs/*.md
*.sqlite3.lock
*.egg-info/
.pytest_cache/

# Integrated operations, setup and licensed worker branding.
!/examples/
!/examples/*.py
!/wrapper/ui/assets/openclaw.svg
!/wrapper/ui/assets/hermes.png
!/wrapper/ui/assets/ollama.png
!/wrapper/ui/assets/lmstudio.png
!/wrapper/ui/assets/claude-code.svg
!/wrapper/job-templates-sources.md

# Vanilla verification and setup remain local.
# Mandatory design gates must travel with the source checkout.
!/.githooks/
!/.githooks/pre-commit
!/.githooks/pre-merge-commit
!/.githooks/pre-push
!/.github/
!/.github/workflows/
!/.github/workflows/design.yml
!/wrapper/scripts/design-audit.mjs
!/wrapper/scripts/design-assets.json
!/wrapper/scripts/design-exceptions.json
.cache/
.verify/
.*.log
*.env

# Reproducible local speech installation.
!/requirements-speech.lock

# Nested UI source belongs to the application.
!/wrapper/ui/components/
!/wrapper/ui/components/ui/
!/wrapper/ui/components/ui/*.tsx
!/wrapper/ui/components/ui/loader-utils/
!/wrapper/ui/components/ui/loader-utils/*.ts
!/wrapper/ui/lib/
!/wrapper/ui/lib/*.ts
