# Only the bootstrap and neutral system sources travel with Git.
*
!/.gitignore
!/AGENTS.md
!/README.md
!/package.json
!/package-lock.json
!/.githooks/
!/.githooks/*
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/system/
!/system/app/
!/system/app/**

# system/app/.gitignore admits individual source formats within the app.
/IDENTITY.md
/knowledge/
/workspaces/
/system/data/
/system/migrations/
/system/layout.json
/system/backups/
node_modules/
.venv/
.git/
.cache/
.verify/
.env
.env.*
*.sqlite*
*.log
